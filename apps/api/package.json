    "kodik:import": "tsx src/scripts/import-kodik-catalogue.ts",
    "kodik:calendar": "tsx src/scripts/sync-kodik-calendar.ts",
    "anime-corner:sync": "tsx src/scripts/sync-anime-corner.ts",
