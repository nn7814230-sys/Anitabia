{
  "name": "@anitabia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "artwork:sync": "tsx src/scripts/sync-anilist-artwork.ts",
    "kodik:attach": "tsx src/scripts/attach-kodik.ts",
    "kodik:sync": "tsx src/scripts/sync-kodik.ts",
